# Copy this file to .env and fill in real values. Never commit .env itself.

# SQLite file. Prisma resolves this relative to the prisma/ folder, so this
# path puts the DB file at prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Long random string used to sign portal login JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a portal login session stays valid before the person must log in
# again, e.g. "12h", "7d".
JWT_EXPIRES_IN="7d"

PORT=4000

# Folder where uploaded call recordings are stored, relative to the project
# root unless given as an absolute path.
STORAGE_ROOT=./storage/recordings

# "true" once the server is behind HTTPS, so the login cookie is only ever
# sent over an encrypted connection.
COOKIE_SECURE=true

# "lax" — the portal reaches this API through its own domain's /api proxy
# (vercel.json in the portal repo), so the cookie is first-party and "lax"
# is the right, safer value. Only use "none" if a browser page must call
# this API directly from a different site (phone browsers will drop the
# cookie in that setup — that was the "Couldn't load stats" bug).
COOKIE_SAME_SITE=lax

# Comma-separated list of portal origins allowed to call this API, e.g.
# "https://portal.example.com,https://portal-preview.vercel.app". The portal's
# proxy forwards the browser's Origin header, so the portal URL must be here.
CORS_ORIGIN=http://localhost:5173

# NODE_ENV=production

# Used once by `npm run seed` to create the first DEVELOPER account. After
# the first login you can change the password from the portal and these two
# values stop mattering.
ADMIN_USERNAME=
ADMIN_PASSWORD=change-this-before-first-run

# Which calendar day a daily report belongs to is decided in this timezone.
FIRM_TIMEZONE=Asia/Tashkent

# The Android app. Copy each release build to <DOWNLOADS_DIR>/ledger.apk
# (default: storage/downloads next to the recordings). When you publish a
# new version, raise APP_LATEST_VERSION_CODE to its versionCode and installed
# apps will offer the update. Leave APP_LATEST_VERSION_CODE empty to disable.
# DOWNLOADS_DIR=./storage/downloads
APP_LATEST_VERSION_CODE=
APP_LATEST_VERSION_NAME=
APP_DOWNLOAD_URL=https://82.115.51.61.nip.io/downloads/ledger.apk
