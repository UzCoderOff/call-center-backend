// Call Center Backend — Prisma schema
//
// Design notes (read this before changing anything):
// - Roles are plain strings ("DEVELOPER" | "BOSS" | "EMPLOYEE"), not a Prisma
//   enum. SQLite has no native enum type; keeping it a validated string
//   avoids provider-specific quirks and keeps a future Postgres migration
//   (via `prisma migrate`) painless.
// - `Employee.employeeId` is the token the Android app is configured with.
//   It authenticates the device sync endpoint. It is deliberately separate
//   from portal login (`User`), which is what a human uses to sign into the
//   dashboard. An Employee may or may not have a linked User account.
// - `Transcript` and `CallAnalysis` are 1:1 with CallLog and are created
//   empty/unused today. They exist now so the near-term AI transcription +
//   review feature is just "start writing rows," not a schema migration on
//   a live production database.
// - `Employee.customFields` is a JSON escape hatch for one-off metadata
//   (notes, tags, etc.) so small additions don't need a migration. It is
//   NOT a substitute for real columns/tables — those still go through a
//   proper Prisma migration, reviewed like any other code change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A portal login account. DEVELOPER and BOSS accounts stand alone.
// EMPLOYEE accounts are linked 1:1 to an Employee record.
model User {
  id                  Int      @id @default(autoincrement())
  username            String   @unique
  passwordHash        String
  role                String // "DEVELOPER" | "BOSS" | "EMPLOYEE"
  employee            Employee?
  active              Boolean  @default(true)
  // True until the user (or a DEVELOPER, via the reset endpoint) sets a
  // password themselves. Lets a DEVELOPER see who's still on a temporary
  // password without ever storing/showing plaintext — see auth.js and
  // employees.js. Starts true because every account is born with a
  // system-generated temp password (see routes/employees.js and seed.js).
  mustChangePassword  Boolean  @default(true)
  passwordChangedAt   DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Employee {
  id           Int       @id @default(autoincrement())
  // Token configured into the Android app. Generated by the server, shown
  // once to the developer/boss when the employee is created.
  employeeId   String    @unique
  name         String
  phoneNumber  String
  active       Boolean   @default(true)

  userId       Int?      @unique
  user         User?     @relation(fields: [userId], references: [id])

  calls        CallLog[]

  // Flexible metadata escape hatch — see schema-level note above.
  customFields Json?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CallLog {
  id                 Int       @id @default(autoincrement())

  employeeId         Int
  employee           Employee  @relation(fields: [employeeId], references: [id])

  // The device-local call log row id from Android's CallLog content
  // provider. Combined with employeeId this is what the sync endpoint
  // dedupes on — a retried/replayed batch from the device never creates
  // duplicate rows.
  deviceCallLogId    String

  phoneNumber        String
  callType           String // "incoming" | "outgoing" | "missed" | "rejected" | "voicemail" | "unknown"
  missed             Boolean
  callTimestampMs    BigInt
  durationSeconds    Int

  // Set only when the app matched a recording file to this call.
  recordingFilename  String?
  // Where the server actually stored the uploaded file (relative to the
  // configured storage root). Null until the file is received.
  recordingPath      String?

  // Set by the device's on-device integrity heuristic (e.g. call log
  // appears to have been cleared between syncs). Null when nothing looked off.
  logIntegrityFlag   String?

  syncedAtMs         BigInt

  transcript         Transcript?
  analysis           CallAnalysis?

  createdAt          DateTime  @default(now())

  @@unique([employeeId, deviceCallLogId])
  @@index([employeeId, callTimestampMs])
}

// One row per sync attempt from a device's Android agent — success or
// failure, including ones that never got far enough to know which employee
// sent them (bad JSON, a multer/multipart error). This is what makes a
// "stuck on Syncing" report on a phone nobody has physical/USB access to
// diagnosable from the portal/DB, instead of only from an on-device log the
// employee has to manually export and send over.
//
// employeeId is stored as the raw string the device sent, not a foreign
// key to Employee — an unknown/typo'd employeeId is itself something we
// need to be able to log and see.
model SyncLog {
  id             Int      @id @default(autoincrement())
  employeeId     String?
  ok             Boolean
  httpStatus     Int
  errorCode      String?
  errorMessage   String?
  callCount      Int?
  recordingCount Int?
  payloadBytes   Int?
  createdAt      DateTime @default(now())

  @@index([employeeId, createdAt])
}

// Empty/unused until the transcription pipeline is wired up. One row per
// call, created (status "pending") as soon as a recording lands, or later
// by a backfill job — whichever comes first.
model Transcript {
  id          Int      @id @default(autoincrement())

  callLogId   Int      @unique
  callLog     CallLog  @relation(fields: [callLogId], references: [id])

  text        String?
  language    String?
  provider    String? // e.g. "elevenlabs"
  status      String   @default("pending") // "pending" | "processing" | "done" | "failed"
  errorMessage String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Empty/unused until the AI review pipeline is wired up. One row per call,
// produced from its Transcript.
model CallAnalysis {
  id               Int      @id @default(autoincrement())

  callLogId        Int      @unique
  callLog          CallLog  @relation(fields: [callLogId], references: [id])

  summary          String?
  whatWentWrong    String?
  improvementAreas String?
  score            Int? // simple 1-10 rating, optional
  model            String? // which LLM produced this review
  status           String   @default("pending") // "pending" | "processing" | "done" | "failed"
  errorMessage     String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
