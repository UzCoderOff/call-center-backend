// Call Center Backend — Prisma schema
//
// Design notes (read this before changing anything):
// - Roles are plain strings ("DEVELOPER" | "BOSS" | "EMPLOYEE"), not a Prisma
//   enum. SQLite has no native enum type; keeping it a validated string
//   avoids provider-specific quirks and keeps a future Postgres migration
//   (via `prisma migrate`) painless. The same goes for every other
//   "status"-like column below.
// - `Employee.employeeId` is the token the Android app is configured with.
//   It authenticates the device sync endpoint. It is deliberately separate
//   from portal login (`User`), which is what a human uses to sign into the
//   dashboard. An Employee may or may not have a linked User account.
// - `Transcript` and `CallAnalysis` are 1:1 with CallLog and are created
//   empty/unused today. They exist now so the near-term AI transcription +
//   review feature is just "start writing rows," not a schema migration on
//   a live production database. See src/lib/events.js for where that
//   pipeline plugs in.
// - `Employee.customFields` is a JSON escape hatch for one-off metadata
//   (notes, tags, etc.) so small additions don't need a migration. It is
//   NOT a substitute for real columns/tables — those still go through a
//   proper Prisma migration, reviewed like any other code change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A portal login account. DEVELOPER and BOSS accounts stand alone.
// EMPLOYEE accounts are linked 1:1 to an Employee record.
model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  passwordHash       String
  role               String // "DEVELOPER" | "BOSS" | "EMPLOYEE"
  employee           Employee?
  active             Boolean   @default(true)
  // True until the user (or a DEVELOPER, via the reset endpoint) sets a
  // password themselves. Lets a DEVELOPER see who's still on a temporary
  // password without ever storing/showing plaintext — see auth.js and
  // employees.js. Starts true because every account is born with a
  // system-generated temp password (see routes/employees.js and seed.js).
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime?

  // Missed calls this person manually marked as "handled" (reached the
  // client some other way — Telegram, in person, a personal phone).
  markedFollowUps CallLog[] @relation("FollowUpMarkedBy")

  // Phones signed in to the Android app with this account.
  devices         Device[]
  reviewedReports Report[] @relation("ReportReviewedBy")

  // The lawyer's appointment calendar, for a BOSS account that has one.
  calendar           Calendar?
  bookedAppointments Appointment[] @relation("AppointmentBookedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A staff member — call-center operator, translator, document clerk, anyone.
// What a person does is configured per person (office, position, whether
// their calls are collected, which daily report they fill in), not baked
// into the schema, so a new kind of job never needs a code change.
model Employee {
  id          Int     @id @default(autoincrement())
  // Legacy device token for the old manually-configured Android agent (the
  // new app signs in with the person's account instead — see Device).
  // Still accepted by the sync endpoint as a fallback.
  employeeId  String  @unique
  name        String
  phoneNumber String?
  active      Boolean @default(true)

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])

  officeId   Int?
  office     Office?   @relation(fields: [officeId], references: [id], onDelete: SetNull)
  positionId Int?
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  // The "collect calls from this person" switch. Off: the Android app never
  // asks for call-log/storage permissions and never syncs. Only call-center
  // staff need it on.
  collectCalls Boolean @default(false)

  // Which daily report form this person fills in (null: none).
  reportTemplateId Int?
  reportTemplate   ReportTemplate? @relation(fields: [reportTemplateId], references: [id], onDelete: SetNull)

  // The lawyer's calendar: "none" | "view" (see free/busy and bookings) |
  // "book" (also book client appointments into published free time).
  calendarAccess String @default("none")

  calls   CallLog[]
  reports Report[]

  // Flexible metadata escape hatch — see schema-level note above.
  customFields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A physical location — e.g. the office by the court, the translation office.
model Office {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  address   String?
  active    Boolean    @default(true)
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// A job preset: choosing a position when creating an account pre-fills
// "collect calls" and the report form. It's copied onto the person, not
// linked live — editing a position never silently changes existing staff.
model Position {
  id               Int             @id @default(autoincrement())
  name             String          @unique
  collectCalls     Boolean         @default(false)
  calendarAccess   String          @default("none")
  reportTemplateId Int?
  reportTemplate   ReportTemplate? @relation(fields: [reportTemplateId], references: [id], onDelete: SetNull)
  employees        Employee[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// A daily report form, built in the portal. `fields` is an ordered list of
// questions — see src/services/reportFields.js for the exact shape and the
// supported types (text, number, money, yes/no, choice, checklist…).
model ReportTemplate {
  id        Int        @id @default(autoincrement())
  name      String
  fields    Json
  active    Boolean    @default(true)
  positions Position[]
  employees Employee[]
  reports   Report[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// One person's report for one day. `fields` is a snapshot of the form's
// questions as they were when the report was submitted, so editing a form
// later never changes what an old report means.
model Report {
  id            Int            @id @default(autoincrement())
  employeeId    Int
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId    Int
  template      ReportTemplate @relation(fields: [templateId], references: [id])
  // Calendar day in the firm's timezone (FIRM_TIMEZONE), "YYYY-MM-DD".
  date          String
  fields        Json
  answers       Json
  submittedAt   DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  reviewedById  Int?
  reviewedBy    User?          @relation("ReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewComment String?

  @@unique([employeeId, templateId, date])
  @@index([date])
}

// A phone signed in to the Android app. Signing in issues a random token;
// only its SHA-256 hash is stored. The app uses it to sync calls and to get
// a fresh portal session without asking for the password again. Revoking a
// device (lost phone, employee left) stops both immediately.
model Device {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  label      String? // phone model, e.g. "HONOR X8b"
  appVersion String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

model CallLog {
  id Int @id @default(autoincrement())

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  // The device-local call log row id from Android's CallLog content
  // provider. On its own it is NOT unique over time: a new/factory-reset
  // phone starts counting from 1 again. Paired with the call's own
  // timestamp (which never changes for a given entry) it is — that pair
  // is what the sync endpoint dedupes on, so a retried batch never
  // double-inserts and a replacement phone never overwrites old history.
  deviceCallLogId String

  phoneNumber     String
  // phoneNumber reduced to a comparable form (see src/lib/phone.js) so
  // "+998 90 123 45 67" and "901234567" are recognised as the same person.
  // Null when the number is hidden/too short to ever match or call back.
  phoneKey        String?
  callType        String // "incoming" | "outgoing" | "missed" | "rejected" | "voicemail" | "unknown"
  missed          Boolean
  callTimestampMs BigInt
  durationSeconds Int

  // Set only when the app matched a recording file to this call.
  recordingFilename String?
  // Where the server actually stored the uploaded file (relative to the
  // configured storage root). Null until the file is received.
  recordingPath     String?

  syncedAtMs BigInt

  // --- Missed-call follow-up (only ever set when missed = true) ---------
  // Recomputed by src/services/followUp.js every time new calls for the
  // same phoneKey arrive, from any employee's phone:
  //   "pending"             nobody has reached this caller yet
  //   "attempted"           someone called back, but nobody picked up
  //   "called_back"         someone called back and the call connected
  //   "client_called_again" the caller rang again and was answered
  //   "handled"             marked by hand in the portal (reached another way)
  //   "no_number"           hidden/unknown number — can't be called back
  followUp           String?
  // The call that resolved (or attempted to resolve) this missed call.
  followUpCallId     Int?
  followUpCall       CallLog?  @relation("FollowUp", fields: [followUpCallId], references: [id], onDelete: SetNull)
  resolvesMissed     CallLog[] @relation("FollowUp")
  // Seconds from the missed call to followUpCall — "how fast did we call back".
  followUpDelaySec   Int?
  followUpMarkedById Int?
  followUpMarkedBy   User?     @relation("FollowUpMarkedBy", fields: [followUpMarkedById], references: [id], onDelete: SetNull)
  followUpMarkedAt   DateTime?

  transcript Transcript?
  analysis   CallAnalysis?

  // Appointments booked from this call.
  appointments Appointment[]

  createdAt DateTime @default(now())

  @@unique([employeeId, deviceCallLogId, callTimestampMs])
  @@index([employeeId, callTimestampMs])
  @@index([phoneKey, callTimestampMs])
  @@index([missed, followUp])
}

// One row per sync attempt from a device's Android agent — success or
// failure, including ones that never got far enough to know which employee
// sent them (bad JSON, a multer/multipart error). This is what makes a
// "stuck on Syncing" report on a phone nobody has physical/USB access to
// diagnosable from the portal/DB, instead of only from an on-device log the
// employee has to manually export and send over.
//
// employeeId is stored as the raw string the device sent, not a foreign
// key to Employee — an unknown/typo'd employeeId is itself something we
// need to be able to log and see.
model SyncLog {
  id             Int      @id @default(autoincrement())
  employeeId     String?
  // Set when the phone authenticated as a signed-in app (Device), rather
  // than with the legacy token.
  deviceId       Int?
  ok             Boolean
  httpStatus     Int
  errorCode      String?
  errorMessage   String?
  callCount      Int?
  recordingCount Int?
  payloadBytes   Int?
  appVersion     String?
  // The device's call-log tamper heuristic for this batch (see
  // SyncWorker.kt). Null when nothing looked off.
  integrityFlag  String?
  // How many call-log entries appear to have been deleted on the phone
  // before they could be synced.
  missingEntries Int?
  createdAt      DateTime @default(now())

  @@index([employeeId, createdAt])
}

// Empty/unused until the transcription pipeline is wired up. One row per
// call, created (status "pending") as soon as a recording lands, or later
// by a backfill job — whichever comes first.
model Transcript {
  id Int @id @default(autoincrement())

  callLogId Int     @unique
  callLog   CallLog @relation(fields: [callLogId], references: [id], onDelete: Cascade)

  text         String?
  language     String?
  provider     String? // e.g. "elevenlabs"
  status       String  @default("pending") // "pending" | "processing" | "done" | "failed"
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Empty/unused until the AI review pipeline is wired up. One row per call,
// produced from its Transcript.
model CallAnalysis {
  id Int @id @default(autoincrement())

  callLogId Int     @unique
  callLog   CallLog @relation(fields: [callLogId], references: [id], onDelete: Cascade)

  summary          String?
  whatWentWrong    String?
  improvementAreas String?
  score            Int? // simple 1-10 rating, optional
  model            String? // which LLM produced this review
  status           String  @default("pending") // "pending" | "processing" | "done" | "failed"
  errorMessage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------------ calendar
//
// The lawyer's appointment calendar. Each week the owner plans their time
// (from their standard week or last week's plan), then publishes it; only
// published weeks are visible to staff, who book client appointments into
// the free ("available") time. Times are minutes from midnight in the
// firm's timezone (FIRM_TIMEZONE) — the firm works in one city.
model Calendar {
  id           Int            @id @default(autoincrement())
  ownerId      Int            @unique
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Shown to staff, e.g. "Advokat Karimov".
  name         String
  // Default appointment length.
  slotMinutes  Int            @default(30)
  // The usual week — every new week starts from it, then each day can be
  // changed: reception on workDays from dayStart to dayEnd, with a lunch
  // break (none when lunchStart is null). Minutes from midnight.
  workDays     String         @default("1,2,3,4,5") // ISO weekdays, 1 = Monday
  dayStart     Int            @default(540)
  dayEnd       Int            @default(1080)
  lunchStart   Int?           @default(720)
  lunchEnd     Int?           @default(780)
  active       Boolean        @default(true)
  weeks        CalendarWeek[]
  appointments Appointment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// One planned week. `blocks`: [{ date, start, end, kind, note? }] where kind
// is "available" (bookable), "busy" (court, a trip…) or "break" (lunch).
// See src/services/calendar.js.
model CalendarWeek {
  id          Int       @id @default(autoincrement())
  calendarId  Int
  calendar    Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  // The Monday, "YYYY-MM-DD".
  weekStart   String
  status      String    @default("draft") // "draft" | "published"
  publishedAt DateTime?
  blocks      Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([calendarId, weekStart])
}

model Appointment {
  id             Int       @id @default(autoincrement())
  calendarId     Int
  calendar       Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  date           String // "YYYY-MM-DD", firm timezone
  start          Int // minutes from midnight
  end            Int
  clientName     String
  clientPhone    String?
  // clientPhone reduced for matching (src/lib/phone.js) — links the
  // appointment to that caller's calls.
  phoneKey       String?
  matter         String? // what it's about
  notes          String?
  status         String    @default("booked") // "booked" | "attended" | "no_show" | "cancelled"
  bookedById     Int
  bookedBy       User      @relation("AppointmentBookedBy", fields: [bookedById], references: [id])
  // Set when booked from a call's page.
  callLogId      Int?
  callLog        CallLog?  @relation(fields: [callLogId], references: [id], onDelete: SetNull)
  cancelReason   String?
  cancelledAt    DateTime?
  cancelledById  Int?
  // When someone other than the booker cancels (the lawyer, or an away
  // period), the booker is asked to let the client know, then ticks this.
  clientInformed Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([calendarId, date])
  @@index([phoneKey])
}
